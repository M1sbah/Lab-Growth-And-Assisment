<link rel="stylesheet" href="/css/login.css">

</head>
<!------ Include the above in your HEAD tag ---------->
<div class="wrapper fadeInDown">
  <div id="formContent">
    <!-- Tabs Titles -->

    <!-- Icon -->
    <div class="fadeIn first">
      <img src="https://pluspng.com/img-png/png-user-icon-circled-user-icon-2240.png" id="icon" alt="User Icon" />
    </div>

    <!-- Login Form -->
    <form action="/student" method="POST" class="login">
      <input type="text" id="login" class="fadeIn second" name="email" placeholder="Student">
      <input type="password" id="password" class="fadeIn third" name="password" placeholder="Password">
      <input type="submit" class="fadeIn fourth" value="Log In">
    </form>

