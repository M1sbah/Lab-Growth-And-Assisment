<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assignment</title>

    <style>
        .content{
           position: relative;
           top: 80px;
           float: left;
           left: 350px;
        }

        .display{
            border: 0;
            outline: none;
            size: 10px;
        }
        .Static-content{
            position: fixed;
            top: 150px;
        }
    </style>
</head>
<body>
    {{>temp}}

    <div class="content">
        <form>
            <div class="Static-content">
                <input class="display" type="text" value="Email:" style="width:50px" readonly/>
                <input class="display" type="text" name="email" value="{{email}}" style="width:500px" readonly/>
                <input class="display" type="text" value="Pid:" style="width:50px" readonly/>
                <input class="display" type="text" name="Pid" value="{{Pid}}" readonly/>
                {{#if subject}}
                    <input class="display" type="text" name="subject" value="{{subject}}" readonly/>
                {{else}}
                    <input class="display" type="text" name="subject" placeholder="Subject" value="{{subject}}" required/>
                {{/if}}
                <br>
            </div>
            <input type="text" placeholder="Enter Question" name="ques" size="5" style="width: 1000px; height:80px" required/><br><br><br>
            <textarea rows="5" cols="33" placeholder="Enter General Answer" name="ans" style="width: 1000px; height:300px" required></textarea><br><br>
            <input type="submit" value="Submit" style="width: 400px;" formaction="submit" formmethod="post" />
            <input type="submit" value="Next" style="width: 400px;" formaction="create" formmethod="post"/>
        </form>
    </div>

    </div>
    </div>
    </div>

    </div><!-- /#wrapper -->

    
</body>
</html>